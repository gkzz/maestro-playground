{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // 共通の Renovate 運用ポリシーは gkzz/renovate-config の default preset に集約する。
  extends: ["github>gkzz/renovate-config"],

  // lockfile メンテナンスの通常スケジュールを、毎月最初の月曜日とする。
  // timezone は共有プリセットの Asia/Tokyo を継承する。
  // 差分がある場合だけPRを作成し、毎月のPR作成は保証しない。
  // ツールは完全固定を維持し、バージョン更新は通常の更新PRで扱う。
  // Renovate の cron は日付と曜日の両方を満たす日に一致する（1〜7日かつ月曜）。
  // https://docs.renovatebot.com/configuration-options/#schedule
  // 新規ブランチ作成前の Dashboard 承認は、共有設定の dependencyDashboardApproval を継承する。
  // Dashboard からの手動承認・作成指示はスケジュールを上書きし、期間外にも実行され得る。
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* * 1-7 * 1"],
  },

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.config/(mise/config|flutter/mise)\\.toml$/"],
      matchStrings: ['min_version = "(?<currentValue>[^"\\s]+)"'],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/setup-mise/action\\.yml$/"],
      matchStrings: ['MISE_VERSION: "(?<currentValue>[^"\\s]+)"'],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // 各環境のチェックサムを GitHub Release の添付ファイルから更新する。
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/setup-mise/action\\.yml$/"],
      matchStrings: [
        '# mise (?<currentValue>v[0-9.]+) (?<depName>[^\\s]+)\\n[ \\t]+MISE_SHA256_[A-Z0-9_]+: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      // mise 本体は gkzz/dotfiles リポジトリで先に更新し、こちらはその後に追従したい。
      // この設定でリポジトリ間の更新順序は制御できないため、マージ前に dotfiles 側の更新を確認する。
      matchManagers: ["custom.regex"],
      matchPackageNames: ["jdx/mise"],
      groupName: "mise CLI",
      groupSlug: "mise-cli",
      // 年をまたぐ major 更新も、全環境のチェックサムと同じ PR にまとめる。
      separateMajorMinor: false,
    },
    {
      matchManagers: ["mise"],
      matchPackageNames: ["flutter"],
      groupName: "Flutter",
      groupSlug: "flutter",
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
      automerge: false,
      prBodyNotes: [
        "Flutter更新はAndroidの3フローと、手動実行したiOSの3フローの成功を確認してからマージしてください。",
      ],
    },
    {
      // mise の GitHub backend は cli- 付きのリリースタグを必要とする。
      // asdf 用の既定ルールによる接頭辞の除去を上書きする。
      matchManagers: ["mise"],
      matchPackageNames: ["mobile-dev-inc/maestro"],
      extractVersion: "^(?<version>cli-\\d+\\.\\d+\\.\\d+)$",
      versioning: "regex:^cli-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
  ],
}
