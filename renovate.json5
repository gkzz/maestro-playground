{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // 共通の Renovate 運用ポリシーは gkzz/renovate-config の default preset に集約する。
  extends: ["github>gkzz/renovate-config"],

  // 固定した検証環境の lockfile は月1回、毎月1日にメンテナンスする。
  // PR 作成には共有方針どおり Dependency Dashboard での承認が必要。
  lockFileMaintenance: {
    enabled: true,
    schedule: ["on the first day of the month"],
  },

  packageRules: [
    {
      // mise の GitHub backend は cli- 付きのリリースタグを必要とする。
      // asdf 用の既定ルールによる接頭辞の除去を上書きする。
      matchManagers: ["mise"],
      matchPackageNames: ["mobile-dev-inc/maestro"],
      extractVersion: "^(?<version>cli-\\d+\\.\\d+\\.\\d+)$",
      versioning: "regex:^cli-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
  ],
}
