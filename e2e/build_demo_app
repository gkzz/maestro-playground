#!/usr/bin/env sh
set -eu

platform="${1:-android}"
case "$platform" in
  android|ios) ;;
  *) echo "usage: $0 [android|ios]" >&2; exit 1 ;;
esac
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_dir="$(CDPATH= cd -- "$script_dir/.." && pwd)"
export MISE_CONFIG_FILE="$repo_dir/.config/flutter/mise.toml"
command -v mise >/dev/null 2>&1 || { echo "mise is required; run make install-flutter first." >&2; exit 1; }
expected_version="$(mise config get --file "$MISE_CONFIG_FILE" tools.flutter)"
command -v flutter >/dev/null 2>&1 || { echo "Flutter $expected_version is required; run make install-flutter and build through make." >&2; exit 1; }
flutter_info="$(flutter --version --machine)"
installed_version="$(printf '%s\n' "$flutter_info" | sed -n 's/.*"frameworkVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
if [ "$installed_version" != "$expected_version" ]; then
  echo "Flutter $expected_version is required; found ${installed_version:-unknown}." >&2
  echo "Run make install-flutter, then make build-demo-app or make build-demo-app-ios." >&2
  exit 1
fi
if [ "$platform" = ios ]; then
  command -v xcrun >/dev/null 2>&1 || { echo "Xcode on macOS is required for the iOS Simulator build" >&2; exit 1; }
fi
# Pin app source so changes on upstream main cannot silently change this test.
revision=7b0d53fb3e1e1740aba00444808718fda279e112
source_dir="$repo_dir/local/demo-app-$revision"
mkdir -p "$source_dir" "$script_dir/apps"
archive="$source_dir/source.tar.gz"
curl -fL --retry 3 "https://codeload.github.com/mobile-dev-inc/Maestro/tar.gz/$revision" -o "$archive"
tar -xzf "$archive" -C "$source_dir" --strip-components=3 "Maestro-$revision/e2e/demo_app"
cd "$source_dir"
flutter pub get
case "$platform" in
  android)
    # Keep the upstream app pinned while tracking AGP updates with Renovate.
    agp_version=9.4.1
    settings=android/settings.gradle.kts
    agp='id("com.android.application") version "8.9.1" apply false'
    if ! grep -Fq "$agp" "$settings"; then
      echo "Expected AGP 8.9.1 declaration not found in $settings; review the demo app build overrides." >&2
      exit 1
    fi
    sed "s/id(\"com.android.application\") version \"8\\.9\\.1\"/id(\"com.android.application\") version \"$agp_version\"/" "$settings" > "$settings.tmp"
    mv "$settings.tmp" "$settings"
    # Flutter 3.47.8 requires Kotlin 2.2.20 or later.
    kotlin_version=2.4.21
    kotlin='id("org.jetbrains.kotlin.android") version "2.1.0" apply false'
    if ! grep -Fq "$kotlin" "$settings"; then
      echo "Expected Kotlin 2.1.0 declaration not found in $settings; review the demo app build overrides." >&2
      exit 1
    fi
    sed "s/id(\"org.jetbrains.kotlin.android\") version \"2\\.1\\.0\"/id(\"org.jetbrains.kotlin.android\") version \"$kotlin_version\"/" "$settings" > "$settings.tmp"
    mv "$settings.tmp" "$settings"
    # The pinned demo app uses Gradle 8.12, below this Flutter version's minimum.
    gradle_version=9.8.2
    wrapper=android/gradle/wrapper/gradle-wrapper.properties
    sed "s/gradle-8\\.12-all\\.zip/gradle-$gradle_version-all.zip/" "$wrapper" > "$wrapper.tmp"
    mv "$wrapper.tmp" "$wrapper"
    flutter build apk
    cp build/app/outputs/flutter-apk/app-release.apk "$script_dir/apps/demo_app.apk"
    # Release build memory before the emulator test starts.
    (cd android && ./gradlew --stop)
    ;;
  ios)
    flutter build ios --simulator
    ditto build/ios/iphonesimulator/Runner.app "$script_dir/apps/demo_app.app"
    ;;
esac
